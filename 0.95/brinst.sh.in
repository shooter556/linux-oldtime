# Linux 0.95 boot + root diskette builder, run on Linux 0.12 with gcc 2.0 (bash 1.12).
# Read from the floppy in drive B:
#   dd if=/dev/fd1 of=/tmp/br bs=1024 count=@SCRIPT_N@
FD=/dev/fd1
D=/usr/src/0.95
L=/usr/src/linux
M=/mnt

usage() {
  echo "usage: sh /tmp/br unpack|build|boot|root|gccpkg -n|--dry-run|-a|--apply"
  echo "  unpack  unpack the package from drive B into $L and $D"
  echo "  build   make the root diskette programs, then the 0.95 kernel"
  echo "  boot    write $L/Image to the blank floppy in drive B"
  echo "  root    mkfs the blank floppy in drive B and fill it as the 0.95 root diskette"
  echo "  gccpkg  write gcc 2.0 + /usr/include + make + ShoeLace and Image (gcc.flp, with the 0.95 HD installer)"
  echo "          and the extra tools + gzip (tools.flp) from this disk to blank floppies in drive B"
  echo "  -n, --dry-run  print commands only;  -a, --apply  really run"
  exit 1
}

run() {
  echo "+ $*"
  if [ $DRY = 0 ]; then eval "$*" || { echo "FAILED: $*"; exit 1; }; fi
}

[ $# = 2 ] || usage
case "$2" in
  -n|--dry-run) DRY=1 ;;
  -a|--apply) DRY=0 ;;
  *) usage ;;
esac

BIN="poe-IGL/init poe-IGL/agetty poe-IGL/login system/mkfs system/mkswap system/mknod"
BIN="$BIN fdisk df mount umount swapon sync uname"
FU="ls cp mv rm ln mkdir rmdir chmod chown chgrp touch dd"
XBIN="bin/vi bin/tar bin/compress"
GCC="usr/local/bin/gcc-2.0 usr/local/lib/gcc usr/local/lib/crt0.o usr/include usr/bin/make"
for p in as ld ar ranlib nm size strip; do GCC="$GCC usr/local/lib/gcc-$p"; done
TOOLS="basename file magic grep egrep sed stty uniq cmp cut du head tail paste mkfifo"
TOOLS="$TOOLS split tac expand unexpand dir vdir em kermit as86 ld86"
DEVS="PS0:b:2:28 PS1:b:2:29 at0:b:2:8 at1:b:2:9"
DEVS="$DEVS hda:b:3:0 hda1:b:3:1 hda2:b:3:2 hda3:b:3:3 hda4:b:3:4"
DEVS="$DEVS hda5:b:3:5 hda6:b:3:6 hda7:b:3:7 hda8:b:3:8"
DEVS="$DEVS hdb:b:3:64 hdb1:b:3:65 hdb2:b:3:66 hdb3:b:3:67 hdb4:b:3:68"
DEVS="$DEVS hdb5:b:3:69 hdb6:b:3:70 hdb7:b:3:71 hdb8:b:3:72"
DEVS="$DEVS ram:b:1:1 mem:c:1:1 kmem:c:1:2 null:c:1:3 port:c:1:4"
DEVS="$DEVS tty:c:5:0 tty0:c:4:0 console:c:4:1 tty1:c:4:1 tty2:c:4:2 tty3:c:4:3"
DEVS="$DEVS tty4:c:4:4 tty5:c:4:5 tty6:c:4:6 tty7:c:4:7 tty8:c:4:8"
DEVS="$DEVS ttys1:c:4:64 ttys2:c:4:65 ttys3:c:4:66 ttys4:c:4:67"

case "$1" in
unpack)
  for d in $L $D; do [ -d $d ] && { echo "$d already exists, move it away first"; exit 1; }; done
  [ -d /usr/src ] || run "mkdir /usr/src"
  run "dd if=$FD bs=1024 skip=@PKG_O@ count=@PKG_N@ | compress -d | (cd /; tar xvf -)"
  echo "next: sh /tmp/br build --apply"
  ;;
build)
  case "`ls -l /usr/local/bin/gcc`" in
    *gcc-2.0) ;;
    *) echo "/usr/local/bin/gcc is not gcc 2.0, run: gccsw 2.0"; exit 1 ;;
  esac
  run "(cd $D; make)"
  run "(cd $L; make)"
  echo "next: put a blank floppy into drive B, then: sh /tmp/br boot --apply"
  ;;
boot)
  [ $DRY = 1 ] || [ -f $L/Image ] || { echo "no $L/Image, run build first"; exit 1; }
  run "dd bs=8192 if=$L/Image of=$FD"
  run "sync"
  echo "next: put another blank floppy into drive B, then: sh /tmp/br root --apply"
  ;;
root)
  if [ $DRY = 0 ]; then
    for f in $BIN $XBIN update; do [ -f $D/$f ] || { echo "no $D/$f, run build first"; exit 1; }; done
    for f in $FU; do [ -f $D/fileutils-3.1/src/$f ] || { echo "no $D/fileutils-3.1/src/$f"; exit 1; }; done
  fi
  [ -d $M ] || run "mkdir $M"
  run "mkfs $FD 1440"
  run "mount $FD $M"
  run "mkdir $M/bin $M/dev $M/etc $M/mnt $M/tmp $M/usr"
  run "cp /bin/sh /usr/bin/cat $M/bin"
  run "(cd $D; cp $BIN $M/bin)"
  run "(cd $D/fileutils-3.1/src; cp $FU $M/bin)"
  run "(cd $D; cp $XBIN $M/bin)"
  run "cp $D/update $D/etc/* /etc/termcap $M/etc"
  run "> $M/etc/mtab; > $M/etc/utmp; > $M/etc/wtmp"
  for d in $DEVS; do
    set -- `echo $d | sed 's/:/ /g'`
    run "mknod $M/dev/$1 $2 $3 $4"
  done
  run "chmod 644 $M/etc/*"
  run "chmod 755 $M/bin/* $M/etc/update"
  run "chmod 666 $M/dev/*"
  run "sync"
  run "umount $FD"
  echo "done: boot from the boot diskette, insert the root diskette when asked"
  ;;
gccpkg)
  # blocks of a file: dd conv=sync pads the last block, so "N+0 records out" counts it
  nblk() { dd if=$1 of=/dev/null bs=1024 conv=sync 2>&1 | sed -n 's/+.* records out$//p'; }
  bsize() { set -- `ls -l $1`; echo $5; }
  T=/tmp/gp
  [ -d $T ] && run "rm -rf $T"
  run "mkdir $T"
  run "(cd /; tar cf - $GCC) | (cd $T; tar xf -)"
  run "cp $D/lib/libc.a $T/usr/local/lib/libc.a"
  run "cp $D/include/string.h $T/usr/include/string.h"
  run "mkdir $T/etc"
  run "cp $D/shoe/shoelace $T"
  run "(cd $D/shoe; cp laceup bootlace winiboot disktab config $T/etc)"
  # ShoeLace ignores rootdev: the Image itself must say /dev/hda2 (0x0302) at offset 508
  run "(dd if=$L/Image bs=508 count=1; echo -n -e '\002\003'; dd if=$L/Image bs=510 skip=1) > $T/Image"
  run "(cd $T; tar cf - usr etc shoelace Image) | compress > /tmp/gcc.Z"
  run "rm -rf $T"
  P=""; for p in $TOOLS; do P="$P usr/bin/$p"; done
  # tools.flp: the tools above plus gzip, built by "build"
  run "mkdir $T"
  run "(cd /; tar cf - $P) | (cd $T; tar xf -)"
  run "cp $D/gzip-1.1.1/gzip $T/usr/bin"
  run "(cd $T; tar cf - usr) | compress > /tmp/tools.Z"
  run "rm -rf $T"
  if [ $DRY = 0 ]; then
    GN=`nblk /tmp/gcc.Z`; TN=`nblk /tmp/tools.Z`
    GB=`bsize /tmp/gcc.Z`; TB=`bsize /tmp/tools.Z`
    let GC=(GB+1023)/1024
    let TC=(TB+1023)/1024
    [ $GC = $GN ] && [ $TC = $TN ] || { echo "bad ls -l size: gcc $GB, tools $TB bytes"; exit 1; }
    let GE=GN+8
    [ $GE -le 1440 ] && [ $TN -le 1440 ] || { echo "too big: gcc $GN, tools $TN blocks"; exit 1; }
  else
    GN="<blocks of /tmp/gcc.Z>"; TN="<blocks of /tmp/tools.Z>"
    GB="<bytes of /tmp/gcc.Z>"; TB="<bytes of /tmp/tools.Z>"
  fi
  run "sed -e 's/@GCC_B@/$GB/; s/@TOOLS_B@/$TB/' $D/inst.sh.in > /tmp/inst"
  # gcc.flp: installer in blocks 0-7, gcc.Z from block 8
  if [ $DRY = 0 ]; then
    IN=`nblk /tmp/inst`
    [ $IN -le 8 ] || { echo "installer too big: $IN blocks"; exit 1; }
  fi
  if [ $DRY = 0 ]; then
    echo -n "blank floppy for gcc.flp in drive B? [y/N] "; read a
    [ "$a" = y ] || exit 1
  fi
  run "dd if=/tmp/inst of=$FD bs=1024 conv=sync"
  run "dd if=/tmp/gcc.Z of=$FD bs=1024 seek=8"
  run "sync"
  if [ $DRY = 0 ]; then
    echo -n "blank floppy for tools.flp in drive B? [y/N] "; read a
    [ "$a" = y ] || exit 1
  fi
  run "dd if=/tmp/tools.Z of=$FD bs=1024"
  run "sync"
  run "rm -f /tmp/gcc.Z /tmp/tools.Z /tmp/inst"
  echo "done: gcc.flp $GN+8 blocks, tools.flp $TN blocks"
  echo "on 0.95 (boot+root floppy, B=gcc.flp): dd if=/dev/PS1 of=/tmp/inst bs=1024 count=8"
  ;;
*)
  usage ;;
esac
exit 0
