# Linux 0.12 HD installer (bash 1.12). Read from install.flp in drive B:
#   dd if=/dev/fd1 of=/tmp/inst bs=1024 count=@SCRIPT_N@
FD=/dev/fd1
HD=/dev/hd0
SWAP=/dev/hd1
PART=/dev/hd2
PN=2
SWAP_CYL=16

usage() {
  echo "usage: sh /tmp/inst part    -n|--dry-run|-a|--apply CYLINDERS HEADS SECTORS"
  echo "       sh /tmp/inst install -n|--dry-run|-a|--apply"
  echo "  part     wipe $HD, $SWAP swap ($SWAP_CYL cyl), $PART Minix, reboot; skip if already so"
  echo "  install  mkswap $SWAP, mkfs $PART, copy root floppy + packages onto it, kernel from the"
  echo "           boot floppy as /Image, ShoeLace on $PART and WiniBoot (default partition $PN) on $HD"
  echo "  -n, --dry-run  print commands only;  -a, --apply  really run"
  exit 1
}

run() {
  echo "+ $*"
  if [ $DRY = 0 ]; then eval "$*" || { echo "FAILED: $*"; exit 1; }; fi
}

get() {
  run "dd if=$FD of=$1 bs=1024 skip=$2 count=$3"
}

getz() {
  run "dd if=$FD bs=1024 skip=$2 count=$3 | $ZCAT > $1"
}

tools() {
  run "rm -f /tmp/fdisk /tmp/mkfs /tmp/mount /tmp/umount /tmp/compress"
  get /tmp/compress @COMPRESS_O@ @COMPRESS_N@
  run "chmod 755 /tmp/compress"
  ZCAT="/tmp/compress -d"
  getz /tmp/fdisk @FDISK_O@ @FDISK_N@
  run "chmod 755 /tmp/fdisk"
}

table() {
  (echo p; echo q) | /tmp/fdisk $HD > /tmp/ptab 2>&1
  grep "^${HD}" /tmp/ptab
}

[ $# -ge 2 ] || usage
CMD=$1
case "$2" in
  -n|--dry-run) DRY=1 ;;
  -a|--apply) DRY=0 ;;
  *) usage ;;
esac

case $CMD in
part)
  [ $# = 5 ] || usage
  C=$3; H=$4; S=$5
  let LAST=H*S*C-1
  let SEND=H*S*SWAP_CYL-1
  let RSTART=SEND+1
  tools
  run "rm -f /tmp/compress"
  if [ $DRY = 0 ] && [ -n "`table`" ]; then
    set -- `grep "^${HD}1 " /tmp/ptab`; P1="$3 $4 $6"
    set -- `grep "^${HD}2 " /tmp/ptab`; P2="$3 $4"
    if [ "$P1" = "$S $SEND 82" ] && [ "$P2" = "$RSTART $LAST" ] && [ `grep -c "^${HD}" /tmp/ptab` = 2 ]; then
      echo "already partitioned as wanted, skip:"; table
      run "rm -f /tmp/fdisk /tmp/ptab"
      echo "next: sh /tmp/inst install --apply"
      exit 0
    fi
    echo "existing partitions, wiping them:"; table
  fi
  run "(echo x; echo h; echo $H; echo s; echo $S; echo c; echo $C; echo r; echo d; echo 4; echo d; echo 3; echo d; echo 2; echo d; echo 1; echo n; echo p; echo 1; echo $S; echo $SEND; echo n; echo p; echo 2; echo $RSTART; echo $LAST; echo t; echo 1; echo 82; echo w) | /tmp/fdisk $HD > /tmp/fdlog 2>&1"
  if [ $DRY = 0 ]; then
    echo "partition table now:"; table
  fi
  run "rm -f /tmp/fdisk /tmp/ptab /tmp/fdlog"
  echo "next: wait 30s (/etc/update syncs), reboot with boot+root floppy, B=install.flp, then:"
  echo "  sh /tmp/inst install --apply"
  ;;
install)
  tools
  if [ $DRY = 0 ]; then
    table > /dev/null
    set -- `grep "^${HD}1 " /tmp/ptab`
    SBLOCKS=$5
    set -- `grep "^${HD}2 " /tmp/ptab`
    BLOCKS=$5
    if [ -z "$SBLOCKS" ] || [ -z "$BLOCKS" ]; then
      echo "need $SWAP and $PART in partition table; fdisk said:"; cat /tmp/ptab; exit 1
    fi
  else
    SBLOCKS="<blocks of $SWAP>"
    BLOCKS="<blocks of $PART>"
  fi
  run "rm -f /tmp/fdisk"
  getz /tmp/mkfs @MKFS_O@ @MKFS_N@
  getz /tmp/mount @MOUNT_O@ @MOUNT_N@
  run "chmod 755 /tmp/mkfs /tmp/mount"
  run "/bin/mkswap $SWAP $SBLOCKS"
  run "/tmp/mkfs $PART $BLOCKS"
  [ -d /mnt ] || run "mkdir /mnt"
  run "/tmp/mount $PART /mnt"
  run "mkdir /mnt/bin /mnt/tmp /mnt/mnt"
  run "cp /tmp/compress /tmp/mkfs /tmp/mount /mnt/bin"
  run "rm -f /tmp/mkfs"
  ZCAT="/mnt/bin/compress -d"
  getz /mnt/bin/tar @TAR_O@ @TAR_N@
  getz /mnt/bin/fdisk @FDISK_O@ @FDISK_N@
  run "chmod 755 /mnt/bin/*"
  run "cd /"
  run "/mnt/bin/tar cf - bin dev etc usr | (cd /mnt; /mnt/bin/tar xf -)"
  run "dd if=$FD bs=1024 skip=@PKG_O@ count=@PKG_N@ | /mnt/bin/compress -d | (cd /mnt; /mnt/bin/tar xvf -)"
  if [ $DRY = 0 ]; then
    echo -n "put boot.flp into drive B, then press Enter "; read a
  fi
  run "echo -n -e '\001\003\002\003' | dd of=$FD bs=1 seek=506 count=4"
  run "dd if=$FD of=/mnt/Image bs=512 count=@IMAGE_S@"
  run "cd /mnt/etc"
  run "./laceup $PART wini"
  run "./laceup -w $PN $HD"
  run "cd /"
  run "/mnt/bin/sync"
  run "cp /mnt/bin/umount /tmp/umount"
  run "chmod 755 /tmp/umount"
  run "/tmp/umount $PART"
  run "rm -f /tmp/umount"
  echo "done. wait 30s (/etc/update syncs), power off, remove both floppies, boot."
  echo "WiniBoot: press $PN, or wait about 15s for the default partition $PN."
  ;;
*) usage ;;
esac
exit 0
