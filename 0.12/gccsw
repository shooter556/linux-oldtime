# gccsw: point /usr/local/bin/gcc and /usr/local/bin/cpp at gcc 1.40 or gcc 2.0
# (Linux 0.12, bash 1.12). Installed by the gcctools.flp script; the drivers live
# side by side as /usr/local/bin/gcc-1.40 and /usr/local/bin/gcc-2.0.
# A driver that is still a regular file (the stock gcc, a gcc140 backup, or the
# gcc 2.0 that make install just put there) is renamed by its "gcc -v" version.
B=/usr/local/bin
L=/usr/local/lib

usage() {
  echo "usage: gccsw 1.40|2.0    symlink $B/gcc and $B/cpp to that gcc"
  echo "       gccsw -h|--help"
  echo "now:"
  ls -l $B/gcc $B/cpp
  exit 1
}

ver() {
  case "`$1 -v 2>&1`" in
    *"version 1.40"*) echo 1.40 ;;
    *"version 2.0"*) echo 2.0 ;;
  esac
}

[ $# = 1 ] || usage
V=$1
case "$V" in
  1.40) C=$L/gcc-cpp ;;
  2.0) C=$L/gcc/i386-gas-sysv/2.0/cpp ;;
  *) usage ;;
esac
for f in $B/gcc $B/gcc140; do
  case "`ls -l $f 2>/dev/null`" in
    -*)
      v=`ver $f`
      [ -n "$v" ] || { echo "$f: not gcc 1.40 or 2.0 (gcc -v)"; exit 1; }
      [ -f $B/gcc-$v ] && { echo "$f is gcc $v, but $B/gcc-$v exists too; remove one"; exit 1; }
      mv $f $B/gcc-$v || exit 1
      echo "$f -> $B/gcc-$v" ;;
  esac
done
G=$B/gcc-$V
[ -f $G ] || { echo "no $G"; exit 1; }
[ "`ver $G`" = $V ] || { echo "$G is not gcc $V (gcc -v)"; exit 1; }
[ -f $C ] || { echo "no $C"; exit 1; }
case "`ls -l $B/cpp 2>/dev/null`" in
  -*) echo "$B/cpp is not a symlink; remove it first"; exit 1 ;;
esac
rm -f $B/gcc $B/cpp
ln -s $G $B/gcc
ln -s $C $B/cpp
ls -l $B/gcc $B/cpp
