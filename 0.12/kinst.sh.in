# Linux kernel source installer (bash 1.12). Read from kernel.flp in drive B:
#   dd if=/dev/fd1 of=/tmp/kinst bs=1024 count=@SCRIPT_N@
FD=/dev/fd1
SRC=/usr/src/linux

usage() {
  echo "usage: sh /tmp/kinst -n|--dry-run|-a|--apply"
  echo "  symlink gas/gld/gar/cpp to gcc-*, unpack stock source into $SRC,"
  echo "  build /bin/sync from /usr/src/sync.c as a gcc test, /usr/bin/uname from"
  echo "  /usr/src/uname.c (put there by install.flp)"
  echo "  -n, --dry-run  print commands only;  -a, --apply  really run"
  exit 1
}

run() {
  echo "+ $*"
  if [ $DRY = 0 ]; then eval "$*" || { echo "FAILED: $*"; exit 1; }; fi
}

[ $# = 1 ] || usage
case "$1" in
  -n|--dry-run) DRY=1 ;;
  -a|--apply) DRY=0 ;;
  *) usage ;;
esac

for p in as:gas ld:gld ar:gar cpp:cpp; do
  set -- `echo $p | sed 's/:/ /'`
  [ -f /usr/local/bin/$2 ] || run "ln -s /usr/local/lib/gcc-$1 /usr/local/bin/$2"
done
[ -d /usr/src ] || run "mkdir /usr/src"
[ -d $SRC ] && { echo "$SRC already exists, remove it first"; exit 1; }
run "dd if=$FD bs=1024 skip=@PKG_O@ count=@PKG_N@ | compress -d | (cd /; tar xvf -)"
run "gcc -o /bin/sync /usr/src/sync.c"
run "/bin/sync"
run "gcc -o /usr/bin/uname /usr/src/uname.c"
echo "next:"
echo "  edit ROOT_DEV, SWAP_DEV, keyboard as mkkernel.sh printed (em or sed)"
echo "  cd $SRC; make"
echo "  put a blank floppy into drive B, then: dd bs=8192 if=Image of=$FD"
exit 0
